u907f\u96f7\u3011\u3010\u672c\u5bb6\u6295\u7a3f\u3011\u3010\u77e5\u58f0\u3011\u672f\u66f2\u6b7b\u4e86\u3010\u304f\u3064\u3046_kutsuu\u3011\u300b</p>"},{"location":"%E6%9C%AF%E5%8A%9B%E5%8F%A3%E7%9B%B8%E5%85%B3/kutsuu.html#\u4e8b\u4ef6\u53d1\u9175","title":"\u4e8b\u4ef6\u53d1\u9175","text":"<p><code>2026-07-20</code> kc \u53d1\u5e03\u52a8\u6001\uff1a \u6211\u60f3\u6e05\u695a\u4e86 \u4ee5\u540e\u8c01\u8981\u662f\u518d\u5411\u6211\u8d34\u8138 \u6211\u4e0d\u4f1a\u7ed9\u4ed6\u9a82\u6211\u7684\u673a\u4f1a...</p> <p>\u5907\u6ce8\uff1a\u4f5c\u54c1\u521a\u6295\u7a3f\u9636\u6bb5\u6d41\u91cf\u4e00\u822c\uff0c\u9884\u4f30\u5f88\u96be\u8fbe\u523010\u4e07\u64ad\u653e\uff0c\u672c\u6761\u52a8\u6001\u53ef\u89c6\u4f5c\u4e00\u4efd\u58f0\u660e\u3002</p> <p><code>2026-07-21</code> kc \u53d1\u5e03\u52a8\u6001\uff1a \u4ec0\u4e48\u610f\u601d\u5440\u9a82\u6211\u6bd4\u9a82\u9ed1\u7ea2\u8fd8\u72e0</p> <p><code>2026-07-22</code> kc \u53d1\u5e03\u52a8\u6001\uff1a \u66f4\u53ef\u6015\u7684\u4e8b\u6765\u4e86 \u4ec0\u4e48\u53eb\u505a\u65b0\u66f2 \u7b2c\u4e00\u5468\uff08\u5468\u699c\uff09\u7981\u6b62\u88ab\u6536\u5f55\u8fdb\u53bb \u5408\u7740\u6211\u767d\u6328\u4e00\u987f\u9a82</p> <p>\u5907\u6ce8\uff1a\u672c\u6761\u627f\u63a5\u4e0a\u4e00\u6761\u52a8\u6001\u5185\u5bb9\u3002</p> <p><code>2026-07-22 20:00\u5de6\u53f3</code> kc \u53d1\u5e03\u52a8\u6001\uff1a \u539f\u56e0\u5df2\u89e3\u51b3 \u56e0\u4e3a\u6570\u636e\u4e0d\u591f \u6211\u628a\u5468\u4e8c00:00\u641e\u6df7\u6dc6 \u6574\u6210\u5468\u4e0900:00 \u679c\u7136\u6211\u662f\u4e2a\u7b28\u86cb\u554a</p> <p><code>2026-07-22</code> kc \u53d1\u5e03\u52a8\u6001\uff1a \u53ea\u8981\u5728\u6211\u8fd9\u91cc\u706b\u5c31\u4e00\u5b9a\u4f1a\u53d1\u751f\u5f88\u591a\u6076\u5fc3\u7684\u4e8b</p> <p><code>2026-07-22 20:00\u5de6\u53f3</code> kc \u53d1\u5e03\u52a8\u6001\uff1a \u5982\u679c\u6211\u4e0a\u699c\u4e86\uff0c\u8bb0\u5f97\u5728\u8fd9\u6761\u52a8\u6001\u56de\u590d\u3002 \u56e0\u4e3a\u6211\u8981\u5220\u9664\u8fd9\u4e2a\u5e73\u53f0\u4e86\u3002 \u6211\u8981\u8eb2\u4e00\u4f1a\u513f\u8fd9\u4e2a\u98ce\u8bc4\u3002 \u6211\u8fd8\u662f\u4e0d\u505a\u672f\u529b\u53e3\u597d\u4e86...</p> <p>\u5907\u6ce8\uff1a\u8be5\u52a8\u6001\u5269\u4f59\u5185\u5bb9\u7f3a\u5931\u3002</p> <p><code>2026-07-22 21:00\u5de6\u53f3</code> kc \u53d1\u5e03\u52a8\u6001\uff1a \u6709\u4eba\u628a\u6211\u5f00\u76d2\u4e86\u3002 \u628a\u6211\u4fe1\u606f\u5168\u5f04\u51fa\u6765\u4e86\uff0c\u771f\u72e0\u554a\uff0c\u771f\u72e0 \u6211\u66f4\u4e0d\u53ef\u80fd\u56de\u6765\u4e86 \u8fd9\u73a9\u610f\u513f\u90fd\u6ca1\u6cd5\u7ef4\u6743...</p> <p>\u5907\u6ce8\uff1a\u8be5\u52a8\u6001\u540e\u7eed\u5185\u5bb9\u5927\u81f4\u8868\u660ekc\u51c6\u5907\u6ce8\u9500\u8d26\u53f7\uff0c\u4e3a\u672c\u9636\u6bb5\u6700\u540e\u4e00\u6761\u52a8\u6001\u3002</p> <p><code>2026-07-25 21:00\u5de6\u53f3</code> kc \u8d26\u53f7\u6ce8\u9500\u3002</p>"}]}